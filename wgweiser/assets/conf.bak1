        url: "javascript:a=prompt('Fritz!Wählilfe (aktuell nur Julians Telefon!)\n\n Bitte zu wählende Telefonnumer eineben:');if(a){window.location='http://red.mrz.ip/waehlhilfe/'+a}"
        tag: "Benutzername ist 'Julian Wiche' 'Franziska Müller' oder 'Johannes Fries' das Passwort ist dasselbe wie für die Fritz!Box"
        subtitle: "Windows Freibabe (SMB) z.B. für einen Mediaplayer auf dem FireTV Stick"
      - name: "TV App (Android/iOs/FireTv)"
        logo: "./assets/icons/fritzTV.jpg"
        url: "javascript:a=confirm('Fritz!TV Android APP Herunterladen?');if(a){window.location='https://play.google.com/store/apps/details?id=de.avm.android.fritzapptv'};a=confirm('Fritz!TV EierPhone APP Herunterladen?');if(a){window.location='https://apps.apple.com/de/app/fritz-app-tv/id911447974'};a=confirm('Dream Player für Fire TV herunterladen');if(a){window.location='https://www.amazon.de/dream-Player-for-Fire-TV/dp/B0193XIPSS/ref=sr_1_1?keywords=dream+player+for+fire+tv&qid=1689000269&s=mobile-apps&sprefix=Dream+tv+pla%2Cmobile-apps%2C94&sr=1-1'}"
        tag: "Hostname: tv.stg.ip bzw. 192.168.178.1"
