      - name: "VLC - TV Sender Playlist"
        logo: "./assets/icons/VLC-Logo-500x313.png"
        url: "javascript:a=confirm('Playlist für SD Sender herunterladen?');if(a){window.location='http://box.stg.ip/dvb/m3u/tvsd.m3u'}a=confirm('Playlist für HD Sender herunterladen?');if(a){window.location='http://box.stg.ip/dvb/m3u/tvhd.m3u'}a=confirm('Playlist für Radiosender herunterladen?');if(a){window.location='http://box.stg.ip/dvb/m3u/radio.m3u'}"
        tag: "Hostname: tv.stg.ip bzw. 192.168.178.1"
