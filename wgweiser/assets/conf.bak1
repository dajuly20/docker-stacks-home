        url: "javascript:alert('1. Schritt: Drucker an machen.\\n3. Schritt: Profit!');prompt('Fuer alle Windoof user:  WINDOWSTASTE + R (Ausfuehren), dann folgendes einfuegen und mit Enter bestaetigen ','rundll32 printui.dll,PrintUIEntry \/in \/n \/y \\\\\\\\fritz.box\\\\printer');a=confirm('Magst oder brauchst du Treiber oder Software fuer diesen SAMSUNG M2070? ');if(a){window.location='https://dl.wiche.eu/drucker.html'}"
