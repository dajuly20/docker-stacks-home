        logo: "./assets/icons/hdd.jpg"
        url: "ftp://box.mrz.ip/"
        tag: "Benutzername ist 'Julian Wiche' 'Franziska Müller' oder 'Johannes Fries' das Passwort ist dasselbe wie für die Fritz!Box"
        subtitle: "FTP Zugang z.B. für einen Mediaplayer auf dem FireTV Stick"
